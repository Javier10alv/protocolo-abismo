# Copia este archivo a .env.local para conectar con Supabase.
# Sin estas variables, el juego funciona en "modo demo local" (localStorage).
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
# La clave de Anthropic NO va aquí: es un secreto de la Edge Function
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
