{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://protocolo-abismo.local/schemas/estado-alumno.schema.json",
  "title": "EstadoAlumno",
  "description": "Estado de una partida de Protocolo Abismo. El alumno nunca ve este objeto; solo lo consume el Dashboard del docente.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "partidaId",
    "alumnoCodigo",
    "alumnoNombre",
    "claseId",
    "escenaActual",
    "habilidades",
    "historial",
    "inventario",
    "completada",
    "iniciadaEn",
    "finalizadaEn"
  ],
  "properties": {
    "version": {
      "type": "string",
      "description": "Versión del guion con el que se jugó. Permite comparar partidas solo si usan el mismo guion.",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "partidaId": {
      "type": "string",
      "format": "uuid"
    },
    "alumnoCodigo": {
      "type": "string",
      "description": "ID único y seudónimo generado al entrar (p. ej. 'K7Q2-M4X9'). Es el que se usa en análisis y exportaciones.",
      "minLength": 3,
      "maxLength": 12,
      "pattern": "^[A-Z0-9-]+$"
    },
    "alumnoNombre": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80,
      "description": "Nombre completo del alumno. Dato personal de un menor: solo lo ve el docente y nunca se envía a la IA."
    },
    "claseId": {
      "type": "string",
      "description": "Código de verificación del docente con el que se entró (agrupa las partidas).",
      "pattern": "^[A-Z0-9-]+$",
      "minLength": 2,
      "maxLength": 20
    },
    "escenaActual": {
      "type": "string",
      "description": "id de la escena en curso, o 'FIN' al terminar."
    },
    "habilidades": {
      "type": "object",
      "description": "Puntos por orden de elección en el hub (1.ª = 10, 2.ª = 7, 3.ª = 5, 4.ª = 3, 5.ª = 1).",
      "additionalProperties": false,
      "required": [
        "logica",
        "creatividad",
        "comunicacion",
        "resiliencia",
        "liderazgo"
      ],
      "properties": {
        "logica": {
          "type": "integer",
          "minimum": 0
        },
        "creatividad": {
          "type": "integer",
          "minimum": 0
        },
        "comunicacion": {
          "type": "integer",
          "minimum": 0
        },
        "resiliencia": {
          "type": "integer",
          "minimum": 0
        },
        "liderazgo": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "historial": {
      "type": "array",
      "description": "Traza de decisiones, en orden. Sirve para auditar la puntuación y para el análisis cualitativo.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "escenaId",
          "opcionId",
          "timestamp"
        ],
        "properties": {
          "escenaId": {
            "type": "string"
          },
          "opcionId": {
            "type": "string",
            "description": "id de la opción elegida (escena de decisión) o del resultado (minijuego)."
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "tiempoRespuestaMs": {
            "type": "integer",
            "minimum": 0,
            "description": "Tiempo en la escena (en un minijuego, su duración). Métrica: no suma puntos."
          },
          "conductas": {
            "type": "array",
            "description": "Solo minijuegos: comportamientos observados (claves de ETIQUETAS_CONDUCTA).",
            "items": {
              "type": "string",
              "pattern": "^[a-z_]+$"
            },
            "uniqueItems": true
          },
          "intentos": {
            "type": "integer",
            "minimum": 0,
            "description": "Solo minijuegos: intentos fallidos antes de resolver. Fallar no penaliza."
          },
          "ayudaRecibida": {
            "type": "boolean",
            "description": "Solo minijuegos: un personaje ayudó tras 3 intentos."
          },
          "precision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "description": "Solo minijuegos: eficiencia 0–100. Métrica descriptiva: no suma puntos."
          },
          "area": {
            "type": "string",
            "enum": [
              "logica",
              "creatividad",
              "comunicacion",
              "resiliencia",
              "liderazgo"
            ],
            "description": "Solo elecciones del hub: área elegida."
          },
          "orden": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "Solo elecciones del hub: posición en la que se eligió."
          },
          "puntos": {
            "type": "integer",
            "minimum": 0,
            "description": "Solo elecciones del hub: puntos ganados por esa posición."
          },
          "indicadores": {
            "type": "object",
            "description": "Solo minijuegos: indicadores observados (0–1) con las claves de la matriz de especificación (logica/evaluacion.ts).",
            "additionalProperties": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "propertyNames": {
              "pattern": "^[a-z_]+$"
            }
          },
          "eventos": {
            "type": "array",
            "description": "Solo minijuegos: telemetría (segundos desde el inicio, tipo y datos).",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "t",
                "tipo"
              ],
              "properties": {
                "t": {
                  "type": "number",
                  "minimum": 0
                },
                "tipo": {
                  "type": "string",
                  "pattern": "^[a-z_]+$"
                },
                "datos": {
                  "type": "object",
                  "additionalProperties": {
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  }
                }
              }
            }
          },
          "retirada": {
            "type": "boolean",
            "description": "El alumno dejó el minijuego a medias para volver a la sala de control (retirada estratégica)."
          },
          "reanudacion": {
            "type": "boolean",
            "description": "Elección del hub que retoma un reto aplazado: no suma puntos de prioridad."
          }
        }
      }
    },
    "inventario": {
      "type": "array",
      "description": "Objetos recogidos explorando las salas.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "escenaId",
          "timestamp"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z_]+$"
          },
          "escenaId": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "completada": {
      "type": "boolean"
    },
    "iniciadaEn": {
      "type": "string",
      "format": "date-time"
    },
    "finalizadaEn": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "examples": [
    {
      "version": "5.0.0",
      "partidaId": "3f1c9a2e-8b4d-4e6a-9c1f-2a7b5d8e0f13",
      "alumnoCodigo": "K7Q2-M4X9",
      "alumnoNombre": "Alumno de Prueba",
      "claseId": "ABISMO2026",
      "escenaActual": "esc_01_hub",
      "habilidades": {
        "logica": 0,
        "creatividad": 0,
        "comunicacion": 0,
        "resiliencia": 0,
        "liderazgo": 0
      },
      "historial": [],
      "inventario": [],
      "completada": false,
      "iniciadaEn": "2026-11-14T10:00:00Z",
      "finalizadaEn": null
    }
  ]
}
